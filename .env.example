# ============================================================
# JARVIS VORTEX - Variables de entorno
# Local: copia a .env | Producción: Secrets en Hugging Face
# ============================================================

# Groq API Keys (varias separadas por coma = reactores)
GROQ_API_KEYS=gsk_clave1,gsk_clave2,gsk_clave3

# Modelo Groq (llama-3.3-70b fue descontinuado en 2026)
GROQ_MODEL=openai/gpt-oss-20b

# Base de datos
# Local:
# DATABASE_URL=sqlite+aiosqlite:///./data/jarvis.db
# Producción (Supabase):
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./data/jarvis.db

# Seguridad
SECRET_KEY=cambia_esto_por_una_cadena_larga_aleatoria

# Firebase Auth
FIREBASE_PROJECT_ID=jarvis-vortex-78100

# Seed admin (primera vez)
ADMIN_USERNAME=ricardo
ADMIN_PASSWORD=cambia_esta_contraseña

ENVIRONMENT=production
DEBUG=false
